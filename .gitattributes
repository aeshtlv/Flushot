# Normalise line endings on commit; check out native ones.
* text=auto

# Source and docs: LF everywhere, so diffs and CI agree with Linux tooling.
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.svg text eol=lf
*.webmanifest text eol=lf

# The logo is copied into the site as the favicon, so the two must stay
# byte-identical apart from line endings.
logo/* text eol=lf

# Anything whose bytes are hashed into a URL must survive a checkout unchanged.
# site/ references its assets as `styles.css?v=<sha256>`, and the hash is taken
# from the file on disk; a CRLF on one machine and an LF on another would give
# two different hashes for the same commit, and the stamp check would fail for
# whoever cloned last. The rules above already cover css, html, js and svg; this
# one keeps every remaining text asset in site/ on LF too.
site/** text eol=lf

# Shell scripts and nginx configs run on the Linux server: a CRLF in them makes
# bash fail with "bad interpreter" and nginx refuse to start. LF is mandatory,
# not cosmetic.
*.sh text eol=lf
deploy/nginx/* text eol=lf

# The instruction for end users is opened in Notepad on a fresh Windows install,
# so it keeps Windows line endings.
share/*.txt text eol=crlf

# Binary files: never diff, never convert.
*.png binary
*.jpg binary
*.webp binary
*.ico binary
*.woff2 binary
*.zip binary
*.exe binary
*.asar binary

# Generated files: keep them out of diffs and out of language statistics.
package-lock.json linguist-generated=true -diff
site/fonts.css linguist-generated=true
build/icon.ico binary
