root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown, and the README uses them.
trim_trailing_whitespace = false

[*.txt]
# End-user instructions ship with Windows line endings.
end_of_line = crlf
