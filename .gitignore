# Dependencies
node_modules/

# Build output (regenerated by `npm run build` and `npm run dist`)
out/
release/
*.tsbuildinfo

# Scratch folders used while the project was being developed. Not part of it.
.tmp/
.cache/
.npm-cache/

# Release archives are 100+ MB each, so they belong in GitHub Releases, not in the
# repository. `npm run dist` builds them; `share/` holds the handoff copies.
share/*.zip
site/downloads/*.zip

# Regenerated by `node scripts/shot-marketing.cjs` from the live page.
site/screenshots/

# Anything generated next to the sources
*.log
.DS_Store
Thumbs.db
desktop.ini
